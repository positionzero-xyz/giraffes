{
  "name": "giraffes",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "AGENT", "class_name": "Agent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Agent"] }],
  "d1_databases": [
    { "binding": "LEDGER", "database_name": "giraffes-ledger", "database_id": "<set on first deploy>", "migrations_dir": "src/ledger/migrations" }
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "vars": { "MODEL_BACKEND": "live" }
}
